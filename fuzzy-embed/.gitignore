# Environment (4.8 GB)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Trained model checkpoints and cached corpus statistics (365 MB, 30 runs).
# Regenerable: scripts/run_experiments.py rebuilds any rung from the config in
# scripts/run_experiments.py LADDER.
artifacts/

# Run logs. Large, and mostly carriage-return progress bars; the substance is in
# LOG.md and results/*.jsonl.
results/*.log

# Raw per-task mteb output (3.8 MB, 555 files). The scores that matter are
# aggregated into results/records*.jsonl, which IS committed.
results/mteb/

# Figures are regenerated by scripts/plot_comparison.py and scripts/plot_params.py.
# (The repository root .gitignore already excludes **/*.png.)
